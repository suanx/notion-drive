# 数据库配置
DB_USER=notion_drive
DB_PASSWORD=notion_drive_secret
DB_NAME=notion_drive

# JWT 密钥（生产环境请更换）
JWT_SECRET=change_this_in_production

# 日志级别
RUST_LOG=info

# S3 兼容存储（可选，用于外部 S3 服务）
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=notion-drive

# CORS 配置（可选，默认允许本地开发）
NOTION__CORS__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
NOTION__SERVER__BASE_URL=http://localhost:8080