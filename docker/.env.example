# 数据库配置
DB_USER=notion_drive
DB_PASSWORD=notion_drive_secret
DB_NAME=notion_drive

# MinIO 对象存储
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin_secret

# JWT 密钥 - 生产环境必须设置强随机密钥！
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# 服务器配置
NOTION_SERVER_BASE_URL=http://localhost:8080

# CORS 配置
NOTION_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志级别
RUST_LOG=info
